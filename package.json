{
  "name": "tabtopia",
  "version": "1.4.0",
  "private": true,
  "description": "Tabtopia — Chrome extension that visualizes browsing telemetry. (This package.json exists only for the dev-time E2E test harness; the extension itself ships unbundled.)",
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:headed": "HEADED=1 playwright test",
    "test:report": "playwright show-report",
    "release:build": "scripts/build-release.sh",
    "benchmark:omnibox": "node tests/perf/omnibox-benchmark.js",
    "benchmark:treemap": "node tests/perf/treemap-benchmark.js",
    "benchmark:boot": "node tests/perf/newtab-boot-benchmark.js",
    "benchmark:profile": "node tests/perf/newtab-profile.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
