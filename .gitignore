# macOS (matches .DS_Store in every directory)
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Backups & logs
# *.orig/*.rej live inside src/ after a merge or patch and would otherwise be
# picked up by a packed zip of the extension source.
*.bak
*.orig
*.rej
*.log
*.patch

# Reproducible release archives are generated from tracked files only.
/dist/

# Node (if tooling is ever added)
node_modules/

# tabtopia MCP: named context captures are the user's live browser snapshots —
# personal data, never committed to a public repo. The server code IS public.
/mcp/data/

# Playwright E2E artifacts
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Claude Code local state. The browser-now skills under .claude/ and .agents/
# ARE public so agents know how to use the MCP tools.
/.claude/worktrees/
/.claude/settings.local.json

# MCP client registration stores an absolute path to this checkout. Keep that
# machine-local; public setup commands live in mcp/README.md.
/.codex/config.toml

# Internal docs — this repo is PUBLIC (github.com/andyed/tabtopia).
# Strategy and audit docs stay on local disk: they carry positioning, and they
# enumerate open findings with file:line, which is not something to publish
# while those findings are open.
/docs/PRODUCT_CASE.md
/docs/HEALTHCHECK_*.md
/docs/AUDIT.md
/docs/MCP_ARCHITECTURE.md
/docs/ANNOUNCEMENT.md
/TODO.md

# Reference papers — third-party copyrighted PDFs. Keep locally, cite by DOI;
# do not redistribute from a public repo.
/references/
